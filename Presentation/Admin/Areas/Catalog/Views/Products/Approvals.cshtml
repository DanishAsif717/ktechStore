@model IEnumerable<ktechStore.Application.DTOs.PendingProductDto>

@{
	ViewData["Title"] = "Product Approvals";
}

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h5 class="mb-0">Pending Vendor Products</h5>
		@* <span class="badge bg-danger">@Model.Count Pending</span> *@
	</div>

	<div class="table-responsive">
		<table class="table table-hover">
			<thead>
				<tr>
					<th>Image</th>
					<th>Product Name</th>
					<th>Vendor</th>
					<th>Category</th>
					<th>Price</th>
					<th>Submitted On</th>
					<th class="text-end">Actions</th>
				</tr>
			</thead>
			<tbody>
				@if (!Model.Any())
				{
					<tr>
						<td colspan="7" class="text-center py-4">No pending products.</td>
					</tr>
				}
				@foreach (var product in Model)
				{
					<tr>
						<td>
							<img src="@product.ImageUrl" alt="@product.Name" width="50" height="50" class="rounded" />
						</td>
						<td>@product.Name</td>
						<td>@product.VendorName</td>
						<td>@product.CategoryName</td>
						<td>@product.Price.ToString("C")</td>
						<td>@product.CreatedAt.ToString("dd MMM yyyy")</td>
						<td class="text-end">
							<form asp-action="Approve" asp-route-id="@product.Id" method="post" class="d-inline">
								@Html.AntiForgeryToken()
								<button type="submit" class="btn btn-sm btn-success">Approve</button>
							</form>
							<button type="button" class="btn btn-sm btn-danger"
									data-bs-toggle="modal" data-bs-target="#rejectModal-@product.Id">
								Reject
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

<!-- Reject Modals -->
@foreach (var product in Model)
{
	<div class="modal fade" id="rejectModal-@product.Id" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<form asp-action="Reject" asp-route-id="@product.Id" method="post">
					@Html.AntiForgeryToken()
					<div class="modal-header">
						<h5 class="modal-title">Reject "@product.Name"</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<label class="form-label">Reason (optional)</label>
						<textarea name="reason" class="form-control" rows="3"></textarea>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-danger">Reject Product</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
