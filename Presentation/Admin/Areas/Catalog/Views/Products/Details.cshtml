@model ktechStore.Application.DTOs.ProductDto

@{
	ViewData["Title"] = "Product Details";
	Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Catalog /</span> Product Details</h4>

<div class="card mb-4">
	<h5 class="card-header">Product Overview</h5>
	<div class="card-body">
		<div class="row">
			<div class="col-md-3 text-center mb-3">
				@if (!string.IsNullOrEmpty(Model.ImageUrl))
				{
					<img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded d-block m-auto shadow-sm" style="max-height: 200px; object-fit: cover;" />
				}
				else
				{
					<div class="bg-light rounded d-flex align-items-center justify-content-center m-auto shadow-sm" style="height: 200px; width: 100%; max-width: 200px;">
						<span class="text-muted">No Image</span>
					</div>
				}
			</div>

			<div class="col-md-9">
				<dl class="row mb-0">
					<dt class="col-sm-3 fw-bold">Name</dt>
					<dd class="col-sm-9">@Model.Name</dd>

					<dt class="col-sm-3 fw-bold">Category</dt>
					<dd class="col-sm-9"><span class="badge bg-label-primary">@Model.CategoryName</span></dd>

					<dt class="col-sm-3 fw-bold">Base Price</dt>
					<dd class="col-sm-9 text-success fw-semibold">Rs. @Model.Price.ToString("N2")</dd>

					<dt class="col-sm-3 fw-bold">Total Stock</dt>
					<dd class="col-sm-9">@Model.Stock</dd>

					<dt class="col-sm-3 fw-bold">SKU</dt>
					<dd class="col-sm-9"><code class="text-dark">@Model.SKU</code></dd>

					<dt class="col-sm-3 fw-bold">Status</dt>
					<dd class="col-sm-9">
						@if (Model.IsActive)
						{
							<span class="badge bg-label-success">Active</span>
						}
						else
						{
							<span class="badge bg-label-danger">Inactive</span>
						}
					</dd>

					<dt class="col-sm-3 fw-bold">Created At</dt>
					<dd class="col-sm-9">@Model.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")</dd>

					<dt class="col-sm-3 fw-bold">Description</dt>
					<dd class="col-sm-9 text-muted">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</dd>
				</dl>
			</div>
		</div>
	</div>
</div>

@if (Model.ProductDetails != null && Model.ProductDetails.Any())
{
	<div class="card mb-4">
		<h5 class="card-header border-bottom mb-3">Available Variants & Configurations</h5>
		<div class="card-body">
			<div class="table-responsive text-nowrap">
				<table class="table table-striped table-bordered table-sm">
					<thead>
						<tr>
							<th>#</th>
							<th>Size</th>
							<th>Color</th>
							<th>Variant Price</th>
							<th>Stock Qty</th>
							<th>Variant Image</th>
						</tr>
					</thead>
					<tbody>
						@{
							int serial = 1;
						}
						@foreach (var detail in Model.ProductDetails)
						{
							<tr>
								<td class="fw-bold">@serial</td>
								<td>@(string.IsNullOrEmpty(detail.Size) ? "-" : detail.Size)</td>
								<td>@(string.IsNullOrEmpty(detail.Color) ? "-" : detail.Color)</td>
								<td class="text-success fw-semibold">
									Rs. @(detail.Price.HasValue ? detail.Price.Value.ToString("N2") : Model.Price.ToString("N2"))
								</td>
								<td>@detail.Stock</td>
								<td>
									@if (!string.IsNullOrEmpty(detail.ImageUrl))
									{
										<a href="@detail.ImageUrl" target="_blank" class="badge bg-label-info">
											<i class="bx bx-link-external me-1"></i> View Image
										</a>
									}
									else
									{
										<span class="text-muted small">No Variant Image</span>
									}
								</td>
							</tr>
							serial++;
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

<div class="mb-4">
	<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
		<span class="tf-icons bx bx-edit-alt me-1"></span>Edit Product
	</a>
	<a asp-action="Index" class="btn btn-outline-secondary">
		<span class="tf-icons bx bx-arrow-back me-1"></span>Back to List
	</a>
</div>
