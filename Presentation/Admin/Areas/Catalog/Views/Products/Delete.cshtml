@model ktechStore.Application.DTOs.ProductDto

@{
	ViewData["Title"] = "Delete Product";
	Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Catalog /</span> Delete Product</h4>

<div class="row">
	<div class="col-md-8">
		<div class="card mb-4 border border-danger">
			<h5 class="card-header bg-label-danger text-danger fw-bold">⚠️ Permanent Deletion Warning</h5>
			<div class="card-body mt-3">
				<p class="mb-4 text-danger fw-bold fs-5">Are you absolutely sure you want to delete this product? This action cannot be undone and will remove all related data.</p>
                
				<div class="row">
					<div class="col-md-3 text-center mb-3">
						@if (!string.IsNullOrEmpty(Model.ImageUrl))
						{
							<img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded d-block m-auto shadow-sm" style="max-height: 150px; object-fit: cover;" />
						}
						else
						{
							<div class="bg-light rounded d-flex align-items-center justify-content-center m-auto shadow-sm" style="height: 150px; width: 100%; max-width: 150px;">
								<span class="text-muted small">No Image</span>
							</div>
						}
					</div>

					<div class="col-md-9">
						<dl class="row mb-0">
							<dt class="col-sm-4 fw-bold">Product Name:</dt>
							<dd class="col-sm-8">@Model.Name</dd>

							<dt class="col-sm-4 fw-bold">SKU:</dt>
							<dd class="col-sm-8"><code>@Model.SKU</code></dd>

							<dt class="col-sm-4 fw-bold">Base Price:</dt>
							<dd class="col-sm-8 text-danger fw-semibold">Rs. @Model.Price.ToString("N2")</dd>

							<dt class="col-sm-4 fw-bold">Stock Quantity:</dt>
							<dd class="col-sm-8">@Model.Stock</dd>

							<dt class="col-sm-4 fw-bold">Category:</dt>
							<dd class="col-sm-8"><span class="badge bg-label-primary">@Model.CategoryName</span></dd>
						</dl>
					</div>
				</div>

				<form asp-action="Delete" class="mt-4 pt-3 border-top">
					<input type="hidden" asp-for="Id" />
					<button type="submit" class="btn btn-danger me-2">
						<i class="bx bx-trash me-1"></i> Confirm Delete
					</button>
					<a asp-action="Index" class="btn btn-outline-secondary">
						<i class="bx bx-arrow-back me-1"></i> Cancel
					</a>
				</form>
			</div>
		</div>

		@if (Model.ProductDetails != null && Model.ProductDetails.Any())
		{
			<div class="card mb-4 border border-warning">
				<h5 class="card-header bg-label-warning text-warning fw-bold">⚠️ Linked Product Variants</h5>
				<div class="card-body mt-3">
					<p class="text-muted mb-3">Deleting this product will also <strong>permanently delete</strong> the following @Model.ProductDetails.Count variant(s):</p>
					<div class="table-responsive text-nowrap">
						<table class="table table-bordered table-sm table-striped">
							<thead>
								<tr>
									<th>Size</th>
									<th>Color</th>
									<th>Price (Rs.)</th>
									<th>Stock</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var detail in Model.ProductDetails)
								{
									<tr>
										<td>@(string.IsNullOrEmpty(detail.Size) ? "-" : detail.Size)</td>
										<td>@(string.IsNullOrEmpty(detail.Color) ? "-" : detail.Color)</td>
										<td>@(detail.Price.HasValue ? detail.Price.Value.ToString("N2") : Model.Price.ToString("N2"))</td>
										<td>@detail.Stock</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}
	</div>
</div>
