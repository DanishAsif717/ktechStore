@model ktechStore.Application.DTOs.ProductDto

@{
	ViewData["Title"] = "Delete Product";
	Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Catalog /</span> Delete Product</h4>

<div class="row">
	<div class="col-md-8">
		<div class="card mb-4 border border-danger">
			<h5 class="card-header bg-label-danger text-danger fw-bold">⚠️ Permanent Deletion Warning</h5>
			<div class="card-body mt-3">
				<p class="mb-4 text-danger fw-bold fs-5">Are you absolutely sure you want to delete this product? This action cannot be undone and will remove all related data.</p>
                
				<div class="row">
					<div class="col-md-3 text-center mb-3">
						@if (!string.IsNullOrEmpty(Model.ImageUrl))
						{
							<img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded d-block m-auto shadow-sm cursor-pointer view-zoom-img" style="max-height: 150px; object-fit: cover;" />
						}
						else
						{
							<div class="bg-light rounded d-flex align-items-center justify-content-center m-auto shadow-sm" style="height: 150px; width: 100%; max-width: 150px;">
								<span class="text-muted small">No Image</span>
							</div>
						}
					</div>

					<div class="col-md-9">
						<dl class="row mb-0">
							<dt class="col-sm-4 fw-bold">Product Name:</dt>
							<dd class="col-sm-8">@Model.Name</dd>

							<dt class="col-sm-4 fw-bold">SKU:</dt>
							<dd class="col-sm-8"><code>@Model.SKU</code></dd>

							<dt class="col-sm-4 fw-bold">Base Price:</dt>
							<dd class="col-sm-8 text-danger fw-semibold">Rs. @Model.Price.ToString("N2")</dd>

							<dt class="col-sm-4 fw-bold">Stock Quantity:</dt>
							<dd class="col-sm-8">@Model.Stock</dd>

							<dt class="col-sm-4 fw-bold">Category:</dt>
							<dd class="col-sm-8"><span class="badge bg-label-primary">@Model.CategoryName</span></dd>
						</dl>
					</div>
				</div>

				<form asp-action="Delete" class="mt-4 pt-3 border-top">
					<input type="hidden" asp-for="Id" />
					<button type="submit" class="btn btn-danger me-2">
						<i class="bx bx-trash me-1"></i> Confirm Delete
					</button>
					<a asp-action="Index" class="btn btn-outline-secondary">
						<i class="bx bx-arrow-back me-1"></i> Cancel
					</a>
				</form>
			</div>
		</div>

		@if (Model.ProductDetails != null && Model.ProductDetails.Any())
		{
			<div class="card mb-4 border border-warning">
				<h5 class="card-header bg-label-warning text-warning fw-bold">⚠️ Linked Product Variants</h5>
				<div class="card-body mt-3">
					<p class="text-muted mb-3">Deleting this product will also <strong>permanently delete</strong> the following @Model.ProductDetails.Count variant(s):</p>
					<div class="table-responsive text-nowrap">
						<table class="table table-bordered table-sm table-striped align-middle">
							<thead>
								<tr>
									<th style="width: 10%;" class="text-center">Image</th>
									<th style="width: 25%;">Size</th>
									<th style="width: 25%;">Color</th>
									<th style="width: 25%;">Price (Rs.)</th>
									<th style="width: 15%;">Stock</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var detail in Model.ProductDetails)
								{
									<tr>
										<td class="text-center">
											@if (!string.IsNullOrEmpty(detail.ImageUrl))
											{
												<div class="border rounded bg-light d-flex align-items-center justify-content-center cursor-pointer view-zoom-img mx-auto" style="width: 40px; height: 40px; overflow: hidden;">
													<img src="@detail.ImageUrl" alt="Variant preview" class="img-fluid" style="max-height: 100%; object-fit: cover;" />
												</div>
											}
											else
											{
												<div class="border rounded bg-light d-flex align-items-center justify-content-center mx-auto text-muted" style="width: 40px; height: 40px;">
													<i class="bx bx-image small"></i>
												</div>
											}
										</td>
										<td>@(string.IsNullOrEmpty(detail.Size) ? "-" : detail.Size)</td>
										<td>@(string.IsNullOrEmpty(detail.Color) ? "-" : detail.Color)</td>
										<td class="text-success fw-semibold">
											Rs. @(detail.Price.HasValue ? detail.Price.Value.ToString("N2") : Model.Price.ToString("N2"))
										</td>
										<td>@detail.Stock</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}
	</div>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content bg-transparent border-0 shadow-none">
			<div class="modal-body text-center p-0">
				<button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
				<img src="" id="modalPreviewTarget" class="img-fluid rounded shadow" style="max-height: 85vh; object-fit: contain;" />
			</div>
		</div>
	</div>
</div>

<style>
	.cursor-pointer { cursor: pointer; transition: transform 0.2s ease; }
	.cursor-pointer:hover { transform: scale(1.05); }
</style>

<script>
	document.addEventListener("DOMContentLoaded", function () {
		const previewModal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
		const modalImg = document.getElementById('modalPreviewTarget');

		// Click to zoom dynamic engine
		document.querySelectorAll('.view-zoom-img').forEach(el => {
			el.addEventListener('click', function () {
				let src = "";
				if(this.tagName === 'IMG') {
					src = this.getAttribute('src');
				} else {
					const childImg = this.querySelector('img');
					if(childImg) src = childImg.getAttribute('src');
				}
				
				if(src && src !== "#") {
					modalImg.setAttribute('src', src);
					previewModal.show();
				}
			});
		});
	});
</script>
