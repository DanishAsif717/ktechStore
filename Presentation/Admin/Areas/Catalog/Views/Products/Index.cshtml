@model IEnumerable<ktechStore.Application.DTOs.ProductDto>

@{
	ViewData["Title"] = "Products List";
	Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Catalog /</span> Products</h4>

<!-- Sneat Styled Table Card -->
<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h5 class="mb-0">All Products</h5>
		<a asp-action="Create" class="btn btn-primary">
			<span class="tf-icons bx bx-plus me-1"></span>Create New Product
		</a>
	</div>
    
	<div class="table-responsive text-nowrap">
		<table class="table table-hover">
			<thead>
				<tr>
					<th>Name</th>
					<th>Category</th>
					<th>Price</th>
					<th>Stock</th>
					<th>SKU</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody class="table-border-bottom-0">
				@foreach (var item in Model)
				{
					<tr>
						<!-- Product Name & Image Thumbnail Combo -->
						<td>
							<div class="d-flex align-items-center">
								@if (!string.IsNullOrEmpty(item.ImageUrl))
								{
									<img src="@item.ImageUrl" alt="@item.Name" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;" />
								}
								else
								{
									<div class="avatar-initial rounded-circle bg-label-secondary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
										<i class="bx bx-package"></i>
									</div>
								}
								<span class="fw-semibold">@item.Name</span>
							</div>
						</td>
                        
						<!-- Category Name -->
						<td>
							<span class="badge bg-label-primary">@item.CategoryName</span>
						</td>
                        
						<!-- Price -->
						<td class="text-success fw-semibold">
							Rs. @item.Price.ToString("N2")
						</td>
                        
						<!-- Stock -->
						<td>
							@if (item.Stock <= 5)
							{
								<span class="text-danger fw-bold">@item.Stock (Low Stock)</span>
							}
							else
							{
								<span>@item.Stock</span>
							}
						</td>
                        
						<!-- SKU -->
						<td>
							<code>@item.SKU</code>
						</td>
                        
						<!-- Status Badge -->
						<td>
							@if (item.IsActive)
							{
								<span class="badge bg-label-success">Active</span>
							}
							else
							{
								<span class="badge bg-label-danger">Inactive</span>
							}
						</td>
                        
						<!-- Sneat Dropdown Actions -->
						<td>
							<div class="dropdown">
								<button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
									<i class="bx bx-dots-vertical-rounded"></i>
								</button>
								<div class="dropdown-menu">
									<a class="dropdown-menu-item dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
										<i class="bx bx-edit-alt me-1"></i> Edit
									</a>
									<a class="dropdown-menu-item dropdown-item" asp-action="Details" asp-route-id="@item.Id">
										<i class="bx bx-show-alt me-1"></i> Details
									</a>
									<a class="dropdown-menu-item dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
										<i class="bx bx-trash me-1"></i> Delete
									</a>
								</div>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
