{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "nextjs-route": {
        "ClusterId": "nextjs-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "admin-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5002/"
          }
        }
      },
      "nextjs-cluster": {
        "Destinations": {
          "nextjs-destination": {
            "Address": "http://localhost:3000/"
          }
        }
      }
    }
  }
}